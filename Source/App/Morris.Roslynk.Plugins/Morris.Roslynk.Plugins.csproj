<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- What a plugin compiles against. At run time the daemon supplies this assembly and Roslyn, so a
		     plugin's own copies are never loaded and the Solution it is handed has the types it compiled against. -->
		<PackageId>Roslynk.Plugins</PackageId>
		<!-- CI overrides Version from the release tag; this is only the local-build fallback. -->
		<Version>0.0.1-local</Version>
		<Description>The contract a Roslynk plugin implements: run inside the Roslynk daemon and read the solutions it has loaded, without loading them again.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/mrpmorris/Roslynk</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mrpmorris/Roslynk</RepositoryUrl>
		<PackageTags>roslynk;roslyn;csharp;plugin</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
	</ItemGroup>

</Project>
