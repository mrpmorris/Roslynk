<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<InternalsVisibleTo Include="Morris.Roslynk.McpTests" />
		<InternalsVisibleTo Include="Morris.Roslynk.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Morris.Roslynk.Plugins\Morris.Roslynk.Plugins.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Build.Locator" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
		<PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
		<PackageReference Include="Microsoft.CodeAnalysis.Features" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
		<!-- Referenced to log and read the design-time build's binary log (CompilerArgumentCapture); like
		     Microsoft.Build.Framework, the runtime assembly comes from the SDK MSBuildLocator resolves. -->
		<PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all">
		  <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- Referenced for the MSBuildWorkspace API, but the runtime assembly must come from the
		     SDK that MSBuildLocator resolves, not our output (per MSBL001). -->
		<PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all">
		  <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all">
		  <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
		<PackageReference Include="ModelContextProtocol" />
	</ItemGroup>

</Project>
