<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<!-- The contract major is fixed by this package; consumers do not set it. -->
		<RoslynkApiVersion Condition="'$(RoslynkApiVersion)' == ''">V1</RoslynkApiVersion>
	</PropertyGroup>

	<!-- Stamps [assembly: RoslynkApiVersion(ApiVersion.V1)] into every consumer, so the loader's
	     reflection-only probe can read the contract major without executing plugin code. -->
	<Target Name="RoslynkStampApiVersion" BeforeTargets="CoreCompile" Condition="'$(RoslynkApiVersion)' == 'V1'">
		<PropertyGroup>
			<RoslynkApiVersionFile>$(IntermediateOutputPath)RoslynkApiVersion.g.cs</RoslynkApiVersionFile>
		</PropertyGroup>
		<ItemGroup>
			<RoslynkApiVersionLine Include="// &lt;autogenerated&gt;" />
			<RoslynkApiVersionLine Include="[assembly: global::Morris.Roslynk.Plugins.V1.RoslynkApiVersion(global::Morris.Roslynk.Plugins.V1.ApiVersion.V1)]" />
		</ItemGroup>
		<WriteLinesToFile File="$(RoslynkApiVersionFile)" Lines="@(RoslynkApiVersionLine)" Overwrite="true" WriteOnlyWhenChanged="true" />
		<ItemGroup>
			<Compile Include="$(RoslynkApiVersionFile)" />
			<FileWrites Include="$(RoslynkApiVersionFile)" />
		</ItemGroup>
	</Target>

	<Target Name="RoslynkRejectUnknownApiVersion" BeforeTargets="CoreCompile" Condition="'$(RoslynkApiVersion)' != '' And '$(RoslynkApiVersion)' != 'V1'">
		<Error Code="RK9001" Text="This Morris.Roslynk.Plugins.V1 package can only stamp contract major V1. Reference the Morris.Roslynk.Plugins.V{n} package for contract major {n}." />
	</Target>

</Project>
