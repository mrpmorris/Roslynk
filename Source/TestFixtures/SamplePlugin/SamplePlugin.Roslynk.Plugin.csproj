<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- The plugin-name rule: the plugin name, the entry assembly's base name and the deployment
		     folder are all {Name} — one rule everywhere, enforced here by the output assembly name. -->
		<AssemblyName>SamplePlugin.Roslynk.Plugin</AssemblyName>
		<RootNamespace>SamplePlugin.Roslynk.Plugin</RootNamespace>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
		<PackageReference Include="ModelContextProtocol" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Plugins\Morris.Roslynk.Plugins.Abstractions\Morris.Roslynk.Plugins.Abstractions.csproj" />
	</ItemGroup>

</Project>
